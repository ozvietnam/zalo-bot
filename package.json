{
  "name": "zalo-hs-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot Zalo tra c\u1ee9u h\u1ea3i quan \u2014 ngu\u1ed3n hs-code-api (OZ Vi\u1ec7t Nam)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning server.js",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/core/**/*.test.mjs\" \"test/giam-sat/**/*.test.mjs\" \"test/gateway/**/*.test.mjs\" \"packs/**/*.test.mjs\" && node --disable-warning=ExperimentalWarning test/test.mjs",
    "eval": "node --disable-warning=ExperimentalWarning eval/run.mjs",
    "audit": "node scripts/audit.mjs",
    "do-sc": "node scripts/do-sc-thuc.mjs",
    "webhook:set": "node scripts/set-webhook.mjs set",
    "webhook:info": "node scripts/set-webhook.mjs info",
    "giam-sat": "node scripts/giam-sat.mjs",
    "giam-sat:dry": "node scripts/giam-sat.mjs --dry-run"
  }
}