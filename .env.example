# Token bot lấy từ Zalo Bot Creator (bot.zapps.me) — KHÔNG commit giá trị thật
ZALO_BOT_TOKEN=

# webhook (production, cần tên miền HTTPS) | polling (chạy thử trên máy, không cần tên miền)
ZALO_MODE=polling
ZALO_WEBHOOK_PATH=/webhook/zalo
# Chuỗi tự đặt, 8–256 ký tự, phải khớp với lúc setWebhook
ZALO_WEBHOOK_SECRET=

# Nguồn dữ liệu: Cổng OZ (MCP)
OZ_MCP_URL=https://mcp.uythacnhapkhau.com/mcp
# Khoá/tài khoản OZ của bot — cần cho công cụ tính điểm (phân loại, SHTT, giải trình…)
OZ_MCP_TOKEN=
# Mặc định gửi "Authorization: Bearer <token>"; đổi nếu Cổng dùng header khác (vd X-API-Key)
OZ_MCP_AUTH_HEADER=Authorization

# Đọc thông số từ ẢNH (tem nhãn, bao bì) bằng Gemini — lấy khoá miễn phí tại aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

PORT=3010
# Số tin tối đa mỗi người/phút
RATE_LIMIT_PER_MIN=10
# Để trống = ai cũng dùng được; điền user_id hoặc id nhóm (phẩy) để giới hạn nội bộ
ALLOW_USERS=
# Tên bot trên Zalo (phẩy) để bỏ "@Tên bot" khi được nhắc trong nhóm — thường tự lấy từ getMe
BOT_NAMES=

# --- Lõi dùng chung (spec 001) ---
# user_id nhân viên (phẩy) được dùng lệnh nội bộ và nhận chuyển tiếp
STAFF_USERS=
# Phòng/nhóm Zalo nhận phiếu, cảnh báo và bản tin cho nhân viên
STAFF_CHAT_ID=
# Thư mục lưu dữ liệu (SQLite). Trên Coolify nên gắn volume vào đây
DATA_DIR=./data
# Trần số tin bot chủ động gửi mỗi phòng/ngày; vượt thì hoãn và mở phiếu
CAP_CHAT_DAY=8
# Trần số tin bot gửi toàn hệ thống/ngày; vượt thì hoãn và cảnh báo
CAP_ALL_DAY=300
# Mẫu regex cấm lộ ra khách (ngăn bằng dấu chấm phẩy, không phân biệt hoa thường). Ví dụ: 0985\D?559\D?918;sk-[a-z0-9]+
BANNED_PATTERNS=
# Thời gian giữ phiên hội thoại, mili giây (mặc định 7200000 = 2 giờ)
SESSION_TTL_MS=7200000
# Số điện thoại công ty (phẩy), bot không coi là số khách. Dạng 0xxxxxxxxx hoặc +84...
COMPANY_PHONES=
