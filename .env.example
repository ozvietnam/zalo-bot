# Token bot lấy từ Zalo Bot Creator (bot.zapps.me) — KHÔNG commit giá trị thật
ZALO_BOT_TOKEN=

# webhook (production, cần tên miền HTTPS) | polling (chạy thử trên máy, không cần tên miền)
ZALO_MODE=polling
# Polling KHÔNG chạy khi bot đang có webhook (bot thật đang chạy) — tránh xoá webhook production.
# Chỉ đặt 1 khi cố ý chiếm bot; xong phải đặt lại: npm run webhook:set -- https://<tên miền>/webhook/zalo
ZALO_FORCE_POLLING=
ZALO_WEBHOOK_PATH=/webhook/zalo
# Chuỗi tự đặt, 8–256 ký tự, phải khớp với lúc setWebhook
ZALO_WEBHOOK_SECRET=

# Nguồn dữ liệu: Cổng OZ (MCP)
OZ_MCP_URL=https://mcp.uythacnhapkhau.com/mcp
# Khoá/tài khoản OZ của bot — cần cho công cụ tính điểm (phân loại, SHTT, giải trình…)
OZ_MCP_TOKEN=
# Mặc định gửi "Authorization: Bearer <token>"; đổi nếu Cổng dùng header khác (vd X-API-Key)
OZ_MCP_AUTH_HEADER=Authorization

# Đọc thông số từ ẢNH (tem nhãn, bao bì) bằng Gemini — lấy khoá miễn phí tại aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Não hiểu câu hỏi ở chế độ Tự động (Gemini function calling) — dùng chung khoá trên.
# Đổi mẫu định tuyến; GEMINI_BRAIN=0 để tắt hẳn (rơi về bộ dò từ khoá)
GEMINI_BRAIN_MODEL=gemini-flash-lite-latest
# Não biên tập: kết quả phân loại dài → bản chốt ngắn, code kiểm từng con số khớp bản gốc; GEMINI_EDITOR=0 để tắt
GEMINI_EDITOR_MODEL=gemini-flash-latest

# Khoá dự phòng: cổng LLM bất kỳ theo chuẩn OpenAI (/chat/completions). Não định tuyến + não biên tập
# tự chuyển sang đây khi Gemini lỗi/quá tải/quá giờ (có dự phòng thì chỉ thử 1 mẫu Gemini). Thiếu 1 trong 3 biến = tắt.
# Ví dụ LLM2_BASE_URL=https://api.example.com/v1 (phần trước /chat/completions). Không commit khoá thật.
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=
# Thời gian chờ tối đa mỗi lần gọi dự phòng, mili giây (mặc định 20000)
LLM2_TIMEOUT_MS=
# Mô hình chính cho não định tuyến + biên tập: gemini (mặc định) | llm2 (khoá trên chạy chính, Gemini thành dự phòng).
# Đọc ảnh luôn dùng Gemini.
LLM_CHINH=

PORT=3010
# Số tin tối đa mỗi người/phút
RATE_LIMIT_PER_MIN=10
# Để trống = ai cũng dùng được; điền user_id hoặc id nhóm (phẩy) để giới hạn nội bộ
ALLOW_USERS=
# Tên bot trên Zalo (phẩy) để bỏ "@Tên bot" khi được nhắc trong nhóm — thường tự lấy từ getMe
BOT_NAMES=

# Thư mục ghi lượt trượt từ vựng (gói 1 cần hỏi thêm, tiền lệ 0 kết quả, khách gõ lại) — off để tắt
TRUOT_DIR=du-lieu-truot

# --- Lõi dùng chung (spec 001) ---
# user_id nhân viên (phẩy) được dùng lệnh nội bộ và nhận chuyển tiếp
STAFF_USERS=
# Phòng/nhóm Zalo nhận phiếu, cảnh báo và bản tin cho nhân viên
STAFF_CHAT_ID=
# Thư mục lưu dữ liệu (SQLite). Trên Coolify nên gắn volume vào đây
DATA_DIR=./data
# Trần số tin bot chủ động gửi mỗi phòng/ngày; vượt thì hoãn và mở phiếu
CAP_CHAT_DAY=8
# Trần số tin bot gửi cả nhóm/ngày (tính theo nhóm, không theo người); vượt thì hoãn
CAP_GROUP_DAY=200
# Trần số tin bot gửi toàn hệ thống/ngày; vượt thì hoãn và cảnh báo
CAP_ALL_DAY=300
# Mẫu regex cấm lộ ra khách (ngăn bằng dấu chấm phẩy, không phân biệt hoa thường). Ví dụ: 0985\D?559\D?918;sk-[a-z0-9]+
BANNED_PATTERNS=
# Thời gian giữ phiên hội thoại, mili giây (mặc định 7200000 = 2 giờ)
SESSION_TTL_MS=7200000
# Số điện thoại công ty (phẩy), bot không coi là số khách. Dạng 0xxxxxxxxx hoặc +84...
COMPANY_PHONES=
